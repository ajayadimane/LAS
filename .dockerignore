# Secrets: settings are passed at run time with --env-file, never baked in.
.env
**/.env

# Local environments and caches
.venv/
venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Not part of the backend image
frontend/
tests/
api_docs/
docs/
# scripts: only the two the image runs (the worker and the migration step).
scripts/*
!scripts/migrate.py
!scripts/dpr_worker.py
deploy/
.claude/
CLAUDE.md
requirements-dev.txt
