# Copy to .env and fill in. Never commit .env.

APP_NAME="LAS Dashboard Middleware"
ENVIRONMENT=local
LOG_LEVEL=INFO
# Path the API is served under, e.g. /las-api -> /las-api/api/v1/..., /las-api/health.
# Empty = root. Must match VITE_API_BASE_PATH in frontend/.env.
CONTEXT_PATH=

# --- Vendor (iWallet) ---
# Only one host is documented. Sandbox vs production: UNKNOWN - ask user.
VENDOR_BASE_URL=https://10.10.20.153:8080
VENDOR_TIMEOUT_SECONDS=10.0
VENDOR_CONNECT_TIMEOUT_SECONDS=5.0
VENDOR_MAX_CONNECTIONS=20

# The vendor host is an RFC-1918 address; its certificate may be self-signed.
# Set to false only if you have confirmed that is the case.
VENDOR_VERIFY_SSL=true

# Program manager used when the dashboard does not send one.
VENDOR_PROGRAM_MANAGER_ID=LAS
# Super admin, used server-side only to create customer logins (IAM add
# user needs Keycloak manage-users, which a BD token lacks). Never commit.
VENDOR_ADMIN_USER_ID=
VENDOR_ADMIN_PASSWORD=

# Outgoing mail: a new customer's login details (Zoho Mail SMTP). Port 465 =
# implicit TLS, 587 = STARTTLS. With 2-factor sign-in, the password is a Zoho
# app password. Leave SMTP_PASSWORD blank to send no mail. Never commit it.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_PASSWORD=
MAIL_FROM=las@integramicro.co.in
MAIL_FROM_NAME=LAS
# Where customers sign in; linked from the email.
DASHBOARD_SIGN_IN_URL=https://demo.botaiml.com/las/signin

# Customer onboarding: the person's business group, the tag of the wallet
# opened for them, and the mobile country code.
VENDOR_GROUP_ID=group1
VENDOR_WALLET_TAG_ID=tag1
CUSTOMER_MOBILE_COUNTRY_CODE=91
# IAM group of customer logins, and the length of their generated password.
CUSTOMER_IAM_GROUP_NAME=LAS.enduser
CUSTOMER_PASSWORD_LENGTH=12
# Placeholder settlement account sent for every customer until the dashboard
# collects a real one. Replace before production.
DEFAULT_SETTLEMENT_ACCOUNT_NO=1234567890
DEFAULT_SETTLEMENT_IFSC_CODE=ICIC0001010

# Mandatory geolocation headers. Whether the dashboard supplies real
# coordinates is UNKNOWN - ask user; these are the fallback.
DEFAULT_GEO_LATITUDE=12.97
DEFAULT_GEO_LONGITUDE=77.59

# Retries apply only to read-only /walletInfoRetrieval paths.
VENDOR_RETRY_ATTEMPTS=3
VENDOR_RETRY_BACKOFF_SECONDS=0.2

# --- LAS services ---
# The catalogue and fees (whole rupees) default to app/core/config.py.
# Override the whole list as JSON, e.g.:
# SERVICES=[{"code":"GEO_CHECK","name":"Geo Check","fee":500,"description":"..."}]
JOINING_FEE=295
# Our cap on uploaded documents/reports. The vendor's own limit is UNKNOWN.
DOCUMENT_MAX_BYTES=5242880
# DOCUMENT_ALLOWED_TYPES=["application/pdf","image/jpeg","image/png"]

# --- scripts/sandbox_smoke.py only ---
# Real credentials for the live login smoke test. Never commit these, and
# never put them in the script.
VENDOR_SMOKE_USER_ID=
VENDOR_SMOKE_PASSWORD=
VENDOR_SMOKE_PROGRAM_MANAGER_ID=
# Sent as X-Original-Forwarded-For. Omitting that header makes the gateway
# return 429, so it must always have a value.
VENDOR_SMOKE_CLIENT_IP=127.0.0.1
