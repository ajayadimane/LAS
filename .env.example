# Copy to .env and fill in. Never commit .env.

APP_NAME="LAS Dashboard Middleware"
ENVIRONMENT=local
LOG_LEVEL=INFO
# Path the API is served under, e.g. /las-api -> /las-api/api/v1/..., /las-api/health.
# Empty = root. Must match VITE_API_BASE_PATH in frontend/.env.
CONTEXT_PATH=

# --- Vendor (iWallet) ---
# Only one host is documented. Sandbox vs production: UNKNOWN - ask user.
VENDOR_BASE_URL=https://10.10.20.153:8080
VENDOR_TIMEOUT_SECONDS=10.0
VENDOR_CONNECT_TIMEOUT_SECONDS=5.0
VENDOR_MAX_CONNECTIONS=20

# The vendor host is an RFC-1918 address; its certificate may be self-signed.
# Set to false only if you have confirmed that is the case.
VENDOR_VERIFY_SSL=true

# Program manager used when the dashboard does not send one.
VENDOR_PROGRAM_MANAGER_ID=LAS
# Super admin, used server-side only to create customer logins (IAM add
# user needs Keycloak manage-users, which a BD token lacks). Never commit.
VENDOR_ADMIN_USER_ID=
VENDOR_ADMIN_PASSWORD=

# Outgoing mail: a new customer's login details (Zoho Mail SMTP). Port 465 =
# implicit TLS, 587 = STARTTLS. With 2-factor sign-in, the password is a Zoho
# app password. Leave SMTP_PASSWORD blank to send no mail. Never commit it.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_PASSWORD=
# SMTP_USERNAME=   # defaults to MAIL_FROM
SMTP_TIMEOUT_SECONDS=15.0
MAIL_FROM=las@integramicro.co.in
MAIL_FROM_NAME=LAS
# Where customers sign in; linked from the email.
DASHBOARD_SIGN_IN_URL=https://demo.botaiml.com/las/signin

# --- OTP (IBC OTP service: SMS + email) ---
# Verifies a customer's mobile and email on registration and on change.
# Separate host from iWallet; authenticated by an api-key header. Never
# commit the key. Blank URL or key = OTPs cannot be sent.
OTP_BASE_URL=
OTP_API_KEY=
OTP_VERIFY_SSL=true
# The switch: true = mobile and email must be verified by OTP (registration,
# email change); false = no OTP anywhere, and the dashboard hides the OTP
# steps. Restart the server after changing it.
OTP_REQUIRED=true
# Signs the OTP tokens handed to the dashboard. Any long random string, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`. Blank = a
# random key per process (tokens die on restart).
OTP_TOKEN_SECRET=
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30

# Customer onboarding: the person's business group, the tag of the wallet
# opened for them, and the mobile country code.
VENDOR_GROUP_ID=group1
VENDOR_WALLET_TAG_ID=tag1
# Fakes the money-moving pool transfer (no real vendor call, no real money) so
# dev/test/Playwright runs can click through pay later end to end. Settings
# refuses this outside environment=local/dev/test -- never set true in a real
# deployment's config.
VENDOR_WALLET_STUB_ENABLED=false
CUSTOMER_MOBILE_COUNTRY_CODE=91
# IAM group of customer logins, and the length of their generated password.
CUSTOMER_IAM_GROUP_NAME=LAS.enduser
# IAM group of BD logins (the token's groupId tells a BD from a customer).
BD_IAM_GROUP_NAME=LAS.admin
CUSTOMER_PASSWORD_LENGTH=12
# Placeholder settlement account sent for every customer until the dashboard
# collects a real one. Replace before production.
DEFAULT_SETTLEMENT_ACCOUNT_NO=1234567890
DEFAULT_SETTLEMENT_IFSC_CODE=ICIC0001010
# --- Opting, payment, documents ---
# The vendor custom-field *values* this app writes and reads; change them only
# if the program manager's setup uses different literal strings.
SERVICE_REQUESTED_VALUE="Awaiting BD"
SERVICE_OPTED_VALUE=Opted
SERVICE_DOCS_UPLOADED_VALUE="Docs uploaded"
SERVICE_APPROVED_VALUE=Approved
SERVICE_REJECTED_VALUE=Rejected
SERVICE_REPORT_READY_VALUE="Report ready"
PAYMENT_STATUS_PAID=Paid
PAYMENT_STATUS_PROCESSING=Processing
PAYMENT_MODE_PAY_NOW="Pay now"
PAYMENT_MODE_PAY_LATER="Pay later"
PAYMENT_MODE_MIXED=Mixed
# A customer's own Pay now waits for the BD to confirm receipt while the QR is
# a placeholder; turn off once a real payment confirmation exists.
CUSTOMER_PAY_NOW_NEEDS_CONFIRMATION=true
DOC_STATUS_UPLOADED=Uploaded
DOC_STATUS_PARTIAL="Partially uploaded"
# Pay later: the pool -> main account transfer (PUT /transfer/systemAccountPayment).
VENDOR_POOL_TRANSFER_TYPE_ID=pool_to_main
VENDOR_POOL_DEBIT_FROM=
VENDOR_MAIN_ACCOUNT_ID=IntegraMain
VENDOR_MAIN_ACCOUNT_TAG_ID=tag1
VENDOR_MAIN_ACCOUNT_GROUP_ID=group1

# Mandatory geolocation headers. Whether the dashboard supplies real
# coordinates is UNKNOWN - ask user; these are the fallback.
DEFAULT_GEO_LATITUDE=12.97
DEFAULT_GEO_LONGITUDE=77.59

# Retries apply only to read-only /walletInfoRetrieval paths.
VENDOR_RETRY_ATTEMPTS=3
VENDOR_RETRY_BACKOFF_SECONDS=0.2

# --- LAS services ---
# The catalogue and fees (whole rupees) default to app/core/config.py.
# Override the whole list as JSON, e.g.:
# SERVICES=[{"code":"GEO_CHECK","name":"Geo Check","fee":500,"description":"..."}]
JOINING_FEE=295
# Our cap on uploaded documents/reports. The vendor's own limit is UNKNOWN.
DOCUMENT_MAX_BYTES=5242880
# DOCUMENT_ALLOWED_TYPES=["application/pdf","image/jpeg","image/png"]

# --- DPR analysis (off by default; read only when DPR_AGENTIC_ENABLED=true) ---
# Needs DPR_DATABASE_URL and DPR_STAGING_ENCRYPTION_KEY too; the worker
# (scripts/dpr_worker.py) refuses to start without all four.
DPR_AGENTIC_ENABLED=false
# DPR_AGENTIC_GEMINI_API_KEY=      # REQUIRED to enable; unset = uploads 503
DPR_AGENTIC_GEMINI_MODEL=gemini-2.5-flash
# Shared secret for the internal /api/v1/internal/dpr-agentic/* routes
# (support/debugging only, never the dashboard). Unset = those routes 403.
# DPR_AGENTIC_INTERNAL_TOKEN=
# Fernet key encrypting uploaded documents until the worker consumes them:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DPR_STAGING_ENCRYPTION_KEY=
# Scanned documents: send page images to Gemini (a separate decision).
DPR_AGENTIC_VISION_ENABLED=false
DPR_AGENTIC_VISION_MAX_PAGES=20
# Per-customer cap on analyses queued in a rolling 24 h window.
DPR_AGENTIC_DAILY_SUBMISSION_LIMIT=5
# true = the API process also starts the worker as a child process. Off when
# the worker runs as its own container/service (the demo: deploy/DEPLOYMENT.md).
DPR_WORKER_AUTOSTART=false
# --- Our Postgres (DPR jobs/reports, intake, pay-later dues) ---
# UAT/prod: one database shared with LAS_Email, Core in schema "core", the
# app connecting as core_app (rows only) -- see deploy/db/README.md.
# DPR_DATABASE_URL=postgresql+psycopg://core_app:<password>@host:5432/las
# DB_SCHEMA=core                      # default public (a local database)
# DB_MIGRATE_ON_STARTUP=false         # default true; UAT/prod run scripts/migrate.py
# DB_MIGRATION_URL=postgresql+psycopg://core_owner:<password>@host:5432/las

# --- Email intake (LAS_Email -> POST /internal/v1/intake/events) ---
# LAS_Email (separate service) reads the mailbox and extracts; we do the rest.
INTAKE_ENABLED=false
# Shared secret; LAS_Email sends it as X-Intake-Key (its CORE_INTAKE_API_KEY).
INTAKE_API_KEY=
# INTAKE_API_KEY_PREVIOUS=   # accepted too while rotating the key
# Fernet key encrypting stored events and attachments (customer PII). Needs
# DPR_DATABASE_URL (same Postgres). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTAKE_ENCRYPTION_KEY=
# Sender address -> BD id; only these senders' mail is acted on. Others that
# pass DKIM/DMARC get one "not a registered BD" reply a day.
# INTAKE_BD_SENDERS={"bd@example.com":"97315"}
# The BD account the intake worker signs in as (needed for every vendor call).
# INTAKE_VENDOR_USER_ID=
# INTAKE_VENDOR_PASSWORD=
# Added to the "not a registered BD" reply, e.g. an email or phone number.
# INTAKE_ADMIN_CONTACT=
# Services whose emailed document also queues its DPR analysis (needs DPR_AGENTIC_ENABLED).
# INTAKE_ANALYSE_SERVICES=["DPR_ANALYSIS"]
# Finished DPR reports younger than this are written back to the wallet + the BD emailed.
# INTAKE_REPORT_SYNC_LOOKBACK_HOURS=72
# INTAKE_MAX_REQUEST_BYTES=16777216
# INTAKE_MAX_ATTACHMENTS=25

# --- scripts/sandbox_smoke.py only ---
# Real credentials for the live login smoke test. Never commit these, and
# never put them in the script.
VENDOR_SMOKE_USER_ID=
VENDOR_SMOKE_PASSWORD=
VENDOR_SMOKE_PROGRAM_MANAGER_ID=
# Sent as X-Original-Forwarded-For. Omitting that header makes the gateway
# return 429, so it must always have a value.
VENDOR_SMOKE_CLIENT_IP=127.0.0.1

# --- DPR analysis cost (USD, for DPR_AGENTIC_GEMINI_MODEL) ---
# Each run stores its cost at these rates (dpr_analysis_runs.cost_usd); left
# NULL unless all four are set. gemini-3.8-flash intro rates, valid to
# 2026-12-31; Google doubles input/output on 2027-01-01 (1.50 / 7.50).
DPR_GEMINI_PRICE_INPUT_PER_MTOK_USD=0.75
DPR_GEMINI_PRICE_OUTPUT_PER_MTOK_USD=3.75
DPR_GEMINI_PRICE_CACHED_INPUT_PER_MTOK_USD=0.075
DPR_GEMINI_PRICE_SEARCH_PER_1K_USD=14
# Optional: also store the cost in rupees at this rate (cost_inr).
# DPR_USD_TO_INR=

# --- DPR analysis: lending bank ---
# The bank a DPR is analysed for = the DPR's own (verified) bank, else the
# BankName given on the dashboard, else this default. Empty = no default.
# DPR_DEFAULT_LENDING_BANK=State Bank of India
# Days a DPR's web-search evidence (policy + market research) is reused for
# the same brief; 0 = no cache.
# DPR_GROUNDING_CACHE_TTL_DAYS=30
