# Where the Vite dev server proxies /api and /health (the FastAPI middleware).
VITE_API_PROXY_TARGET=http://localhost:8000

# Context paths, baked in at build time (rebuild after changing). Empty = root.
# The UI's path, e.g. /las -> https://host/las/
VITE_BASE_PATH=
# The middleware's path; must equal CONTEXT_PATH in the backend .env,
# e.g. /las-api -> requests go to /las-api/api/v1/...
VITE_API_BASE_PATH=
