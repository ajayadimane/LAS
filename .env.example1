# LAS Dashboard Middleware -- example environment file.
#
# Copy to .env and fill in the values marked REQUIRED / recommended. Every
# other setting below has a working default (see app/core/config.py, which
# is the source of truth -- this file documents it, not the other way
# around). Uncommented lines show the actual default; commented lines need a
# real value for that feature to work.
#
#   cp .env.example .env
#   chmod 600 .env   # several of these are secrets

# --- App -------------------------------------------------------------------
APP_NAME="LAS Dashboard Middleware"
ENVIRONMENT=local
LOG_LEVEL=INFO
# Path the app is served under, e.g. "/las-api" -> /las-api/api/v1/...,
# /las-api/health, /las-api/docs. Empty = served at the root.
CONTEXT_PATH=/las-api

# --- Vendor (iWallet) --------------------------------------------------------
# Sandbox vs production split is UNKNOWN -- ask the vendor. The sandbox
# moved to 10.10.20.153 on 2026-10-27; VENDOR_VERIFY_SSL=false is a local/
# sandbox-only workaround for its cert not matching an IP SAN -- never set
# this in production (see CLAUDE.md).
VENDOR_BASE_URL=https://10.10.20.153:8080
VENDOR_VERIFY_SSL=true
VENDOR_TIMEOUT_SECONDS=10.0
VENDOR_CONNECT_TIMEOUT_SECONDS=5.0
VENDOR_MAX_CONNECTIONS=20
VENDOR_PROGRAM_MANAGER_ID=LAS
VENDOR_RETRY_ATTEMPTS=3
VENDOR_RETRY_BACKOFF_SECONDS=0.2

# REQUIRED for customer-login creation (POST /api/v1/bd/customers) -- the IAM
# add-user call needs Keycloak's manage-users role, which a BD token lacks.
# Unset = that step fails with ADMIN_NOT_CONFIGURED; registration itself
# still succeeds (see app/services/admin_session.py).
# VENDOR_ADMIN_USER_ID=
# VENDOR_ADMIN_PASSWORD=

# --- Outgoing mail (customer login details) ---------------------------------
# Zoho Mail over SMTP. Unset SMTP_PASSWORD = no mail is sent (reported in the
# response as credentials_email_error, never a failed request).
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
# SMTP_USERNAME=                 # defaults to MAIL_FROM
# SMTP_PASSWORD=                 # a Zoho app password, not the account password
SMTP_TIMEOUT_SECONDS=15.0
MAIL_FROM=las@integramicro.co.in
MAIL_FROM_NAME=LAS
DASHBOARD_SIGN_IN_URL=https://demo.botaiml.com/las/signin

# --- Customer onboarding -----------------------------------------------------
VENDOR_GROUP_ID=group1
VENDOR_WALLET_TAG_ID=tag1
CUSTOMER_MOBILE_COUNTRY_CODE=91
CUSTOMER_IAM_GROUP_NAME=LAS.enduser
BD_IAM_GROUP_NAME=LAS.admin
CUSTOMER_PASSWORD_LENGTH=12
# Placeholder, the same for every customer (user's instruction) -- replace
# before production.
DEFAULT_SETTLEMENT_ACCOUNT_NO=1234567890
DEFAULT_SETTLEMENT_IFSC_CODE=ICIC0001010

# --- Opting, payment, documents ----------------------------------------------
# These are the vendor custom-field *values* this app writes/reads; only
# change them if the program manager's setup uses different literal strings.
SERVICE_REQUESTED_VALUE="Awaiting BD"
SERVICE_OPTED_VALUE=Opted
SERVICE_DOCS_UPLOADED_VALUE="Docs uploaded"
SERVICE_APPROVED_VALUE=Approved
SERVICE_REJECTED_VALUE=Rejected
SERVICE_REPORT_READY_VALUE="Report ready"
PAYMENT_STATUS_PAID=Paid
PAYMENT_STATUS_PROCESSING=Processing
PAYMENT_MODE_PAY_NOW="Pay now"
PAYMENT_MODE_PAY_LATER="Pay later"
PAYMENT_MODE_MIXED=Mixed
CUSTOMER_PAY_NOW_NEEDS_CONFIRMATION=true
DOC_STATUS_UPLOADED=Uploaded
DOC_STATUS_PARTIAL="Partially uploaded"

VENDOR_POOL_TRANSFER_TYPE_ID=pool_to_main
VENDOR_POOL_DEBIT_FROM=
VENDOR_MAIN_ACCOUNT_ID=IntegraMain
VENDOR_MAIN_ACCOUNT_TAG_ID=tag1
VENDOR_MAIN_ACCOUNT_GROUP_ID=group1

# Geolocation headers are mandatory on every vendor call. Whether the
# dashboard supplies real end-user coordinates is UNKNOWN -- ask the vendor;
# these are the fallback sent until then.
DEFAULT_GEO_LATITUDE=12.97
DEFAULT_GEO_LONGITUDE=77.59

# --- LAS services -------------------------------------------------------------
JOINING_FEE=295
DOCUMENT_MAX_BYTES=2097152
# JSON list; only set this if you need to change the catalogue from
# app/core/config.py's DEFAULT_SERVICES.
# SERVICES='[{"code":"GEO_CHECK","name":"Geo Check","fee":500,"field_id":"GeoCheck"}]'
# DOCUMENT_ALLOWED_TYPES='["application/pdf","image/jpeg","image/png"]'

# =============================================================================
# DPR Agentic preview -- feature-gated, off by default. Everything below is
# only read when DPR_AGENTIC_ENABLED=true. See docs/MIDDLEWARE_API.md's
# "Feature-gated: DPR Agentic preview" section for the full contract, and
# app/services/dpr_agentic/INCREMENT*.md for what each setting is for.
# =============================================================================

DPR_AGENTIC_ENABLED=false

# REQUIRED to enable: a Gemini API key. Unset = the upload endpoint 503s.
# DPR_AGENTIC_GEMINI_API_KEY=
DPR_AGENTIC_GEMINI_MODEL=gemini-2.5-flash

# Shared secret for the internal /api/v1/internal/dpr-agentic/* routes
# (support/debugging only, never the dashboard). Unset = those routes 403.
# DPR_AGENTIC_INTERNAL_TOKEN=

# REQUIRED to queue analysis at all (not just run the experimental inline
# internal endpoints): Core LAS's own Postgres for the job registry,
# encrypted upload staging, branch status and report artifacts. This is
# never Wallet's database -- Wallet stays the sole owner of customer,
# document and payment records. Unset = the Wallet write in
# /document-with-analysis still succeeds, but analysis is never queued
# (analysis_status: "NOT_QUEUED") and GET .../report always 503s.
# DPR_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dpr

# REQUIRED alongside DPR_DATABASE_URL: a Fernet key encrypting the uploaded
# document's bytes at rest until scripts/dpr_worker.py consumes them.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset = same effect as DPR_DATABASE_URL unset (analysis never queued).
# DPR_STAGING_ENCRYPTION_KEY=

# Vision/OCR fallback for a scanned document (sends page images, not just
# text, to Gemini -- a separate decision from DPR_AGENTIC_ENABLED).
DPR_AGENTIC_VISION_ENABLED=false
DPR_AGENTIC_VISION_MAX_PAGES=20

# Per-customer cap on analyses queued in a rolling 24h window, across all
# their services. Never blocks the Wallet write, only queuing analysis.
DPR_AGENTIC_DAILY_SUBMISSION_LIMIT=5
